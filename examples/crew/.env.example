# Copy to .env (examples/crew/.env) and fill in. Nothing here is ever recorded by Agent X-Ray.
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional: better search results. Without it the crew uses DuckDuckGo (no key needed).
TAVILY_API_KEY=

# Optional model overrides. Defaults are checked against each provider's docs but model
# names change: if a call fails with "model not found", pick a current one from
#   https://console.groq.com/docs/models   and   https://ai.google.dev/gemini-api/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
